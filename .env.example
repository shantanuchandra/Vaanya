# Required for live multilingual speech, translation, and TTS.
SARVAM_API_KEY=

# Required when the Telegram patient follow-up is connected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEMO_CHAT_ID=

# Default extraction provider. Can be replaced behind the adapter.
OPENAI_API_KEY=

# Browser-safe Supabase configuration. RLS remains mandatory.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Keep false for repeatable rehearsals; enable for the final immutable demo run.
USE_SUPABASE_STORE=false

# Generate a strong random value before hosting.
APP_SESSION_SECRET=
